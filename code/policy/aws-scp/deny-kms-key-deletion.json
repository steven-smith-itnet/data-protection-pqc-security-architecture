{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyKmsKeyDeletionExceptBreakGlass",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DeleteImportedKeyMaterial"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/break-glass"
        }
      }
    }
  ]
}
